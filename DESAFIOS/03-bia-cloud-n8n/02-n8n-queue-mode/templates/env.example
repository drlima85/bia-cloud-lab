# ==============================================================================
# Trilha N8N na AWS - Desafio 02: N8N Queue Mode
# Modelo Sanitizado de Variáveis de Ambiente para Orquestração e Deploy
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para o seu ambiente operacional local:
#      cp env.example .env && chmod 600 .env
# 2. Preencha os identificadores reais da sua infraestrutura AWS.
# 3. NUNCA versione o arquivo .env preenchido no controle de versão Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações Globais da AWS
# ------------------------------------------------------------------------------
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=<SUA_CONTA_AWS_12_DIGITOS>
AWS_PROFILE=default
VPC_ID=vpc-<ID_DA_SUA_VPC>
SUBNET_2A=subnet-<ID_SUBNET_PUBLICA_2A>
SUBNET_2B=subnet-<ID_SUBNET_PUBLICA_2B>

# ------------------------------------------------------------------------------
# Certificados e Resolução DNS (Borda)
# ------------------------------------------------------------------------------
ACM_CERTIFICATE_ARN=arn:aws:acm:<REGIAO>:<CONTA>:certificate/<ID_CERTIFICADO>
ROUTE53_HOSTED_ZONE_ID=Z<ID_HOSTED_ZONE>
ROUTE53_RECORD_NAME=n8n.<SEU_DOMINIO_OU_SUBDOMINIO>

# ------------------------------------------------------------------------------
# AWS Systems Manager Parameter Store (Segredos SecureString)
# ------------------------------------------------------------------------------
SSM_DB_PASSWORD_PATH=/n8n/db_password
SSM_ENCRYPTION_KEY_PATH=/n8n/encryption_key
SSM_VALKEY_TOKEN_PATH=/n8n/valkey_token

# ------------------------------------------------------------------------------
# Grupos de Segurança (Security Groups)
# ------------------------------------------------------------------------------
SG_ALB_ID=sg-<ID_SECURITY_GROUP_ALB>
SG_EC2_ID=sg-<ID_SECURITY_GROUP_EC2>
SG_DB_ID=sg-<ID_SECURITY_GROUP_RDS>
SG_VALKEY_ID=sg-<ID_SECURITY_GROUP_VALKEY>

# ------------------------------------------------------------------------------
# Amazon RDS PostgreSQL 16.x (Banco Relacional Dedicado)
# ------------------------------------------------------------------------------
RDS_DB_NAME=n8n
RDS_ENDPOINT=<ID_DA_INSTANCIA_RDS>.<HASH>.<REGIAO>.rds.amazonaws.com
RDS_PORT=5432
DB_SUBNET_GROUP=n8n-db-subgrp

# ------------------------------------------------------------------------------
# Amazon ElastiCache Valkey 7.2 (Message Broker em Fila)
# ------------------------------------------------------------------------------
VALKEY_REPLICATION_GROUP_ID=n8n-valkey
VALKEY_ENDPOINT=master.<REPLICATION_GROUP_ID>.<HASH>.<REGIAO>.cache.amazonaws.com
VALKEY_PORT=6379
VALKEY_TLS_ENABLED=true
VALKEY_SUBNET_GROUP=n8n-valkey-subgrp

# ------------------------------------------------------------------------------
# Application Load Balancer & Target Group
# ------------------------------------------------------------------------------
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:<REGIAO>:<CONTA>:targetgroup/tg-n8n/<HASH>
ALB_ARN=arn:aws:elasticloadbalancing:<REGIAO>:<CONTA>:loadbalancer/app/n8n-alb/<HASH>
ALB_DNS=n8n-alb-<HASH>.<REGIAO>.elb.amazonaws.com
LISTENER_ARN=arn:aws:elasticloadbalancing:<REGIAO>:<CONTA>:listener/app/n8n-alb/<HASH>/<HASH>

# ------------------------------------------------------------------------------
# Auto Scaling & ECS Compute (Host EC2 AL2023 ECS-Optimized)
# ------------------------------------------------------------------------------
LAUNCH_TEMPLATE_NAME=lt-n8n-queue-mode
ASG_NAME=asg-n8n-queue-mode
ECS_CLUSTER_NAME=cluster-n8n
CAPACITY_PROVIDER_NAME=cp-n8n

# ------------------------------------------------------------------------------
# Serviços Amazon ECS (Main e Worker Desacoplados)
# ------------------------------------------------------------------------------
MAIN_TASK_DEF_FAMILY=task-def-n8n-main
WORKER_TASK_DEF_FAMILY=task-def-n8n-worker
MAIN_SERVICE_NAME=svc-n8n-main
WORKER_SERVICE_NAME=svc-n8n-worker
CLOUDWATCH_LOG_GROUP=/ecs/n8n-ec2
CLOUDWATCH_RETENTION_DAYS=7
