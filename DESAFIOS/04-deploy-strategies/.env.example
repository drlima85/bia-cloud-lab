# ==============================================================================
# .env.example — Modelo de Configuração de Ambiente para o BIA Cloud Lab
# Trilha 04: Estratégias de Deploy & Resiliência no Amazon ECS (Desafio 02)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env no mesmo diretório:
#    cp .env.example .env
# 2. Preencha com os valores correspondentes à sua conta AWS e ambiente de teste.
# 3. NUNCA comite o arquivo .env no Git (ele já está no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciais e Identidade AWS (Mandatório para Execução Real)
# ------------------------------------------------------------------------------
# ID da Conta AWS de 12 dígitos autorizada para operações de release/rollback.
# Os scripts bloqueiam qualquer execução se a identidade STS divergir deste valor.
AWS_ACCOUNT_ID="123456789012"
AUTHORIZED_ACCOUNT="123456789012"

# Perfil da AWS CLI configurado localmente (ex: agy-aws-lab, default, etc.)
AWS_PROFILE="seu-perfil-aws"

# Região da AWS onde os recursos foram provisionados
AWS_REGION="us-east-2"

# ------------------------------------------------------------------------------
# 2. Configurações de Repositório de Contêineres (Amazon ECR)
# ------------------------------------------------------------------------------
# Nome do repositório no ECR
DEFAULT_ECR_REPO="bia-cloud-lab"

# ------------------------------------------------------------------------------
# 3. Configurações de Ambientes ECS e Endpoints ALB
# ------------------------------------------------------------------------------
# Ambiente padrão ativo quando a flag -E/--env não for informada [app | alb | didatico]
DEFAULT_ENV="app"

# Timeout máximo em segundos para aguardar estabilização do serviço ECS
DEFAULT_TIMEOUT="600"

# --- Ambiente Principal ("app"): ALB + ECS sob EC2 ---
ENV_APP_CLUSTER="cluster-bia-app"
ENV_APP_SERVICE="service-bia-cloud-app"
ENV_APP_TASK_FAMILY="task-def-bia-cloud-app"
ENV_APP_CONTAINER_NAME="bia-cloud-app"
# URL pública do Application Load Balancer para o Smoke Test de versão:
ENV_APP_ALB_URL="http://seu-alb-dns.us-east-2.elb.amazonaws.com/api/versao"
# Revisão homologada estável de partida (baseline)
ENV_APP_HOMOLOGATED_BASELINE="15"

# --- Ambiente Secundário ("alb"): Segundo serviço no mesmo cluster ---
ENV_ALB_CLUSTER="cluster-bia-app"
ENV_ALB_SERVICE="service-bia-cloud-alb"
ENV_ALB_TASK_FAMILY="task-def-bia-cloud-alb"
ENV_ALB_CONTAINER_NAME="bia-cloud-alb"
ENV_ALB_ALB_URL="http://seu-alb-dns.us-east-2.elb.amazonaws.com/"
ENV_ALB_HOMOLOGATED_BASELINE="1"
