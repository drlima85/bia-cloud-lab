{
  "targetGroups": [
    {
      "name": "tg-bia-blue",
      "protocol": "HTTP",
      "port": 8080,
      "vpcId": "${VPC_ID}",
      "targetType": "ip",
      "healthCheckProtocol": "HTTP",
      "healthCheckPort": "8080",
      "healthCheckPath": "/api/versao",
      "healthCheckIntervalSeconds": 15,
      "healthCheckTimeoutSeconds": 5,
      "healthyThresholdCount": 2,
      "unhealthyThresholdCount": 3,
      "matcher": {
        "httpCode": "200"
      },
      "targetGroupAttributes": [
        {
          "key": "deregistration_delay.timeout_seconds",
          "value": "30"
        }
      ]
    },
    {
      "name": "tg-bia-green",
      "protocol": "HTTP",
      "port": 8080,
      "vpcId": "${VPC_ID}",
      "targetType": "ip",
      "healthCheckProtocol": "HTTP",
      "healthCheckPort": "8080",
      "healthCheckPath": "/api/versao",
      "healthCheckIntervalSeconds": 15,
      "healthCheckTimeoutSeconds": 5,
      "healthyThresholdCount": 2,
      "unhealthyThresholdCount": 3,
      "matcher": {
        "httpCode": "200"
      },
      "targetGroupAttributes": [
        {
          "key": "deregistration_delay.timeout_seconds",
          "value": "30"
        }
      ]
    }
  ]
}
