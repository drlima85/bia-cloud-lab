# ==============================================================================
# BIA Cloud Lab — AI Bedrock & Generative AI (.env.example)
# ==============================================================================
# NOTA DE USO:
# Este arquivo é estritamente DOCUMENTAL e serve como modelo de referência.
# Os scripts NÃO carregam este arquivo automaticamente nem utilizam bibliotecas como dotenv.
# Defina as variáveis diretamente na sua sessão de terminal (ex: export VARIAVEL=valor).
# ==============================================================================

# Perfil da AWS configurado no ~/.aws/credentials (obrigatório para Shell, opcional para Node)
AWS_PROFILE=SEU_PERFIL_AWS

# Região oficial do Amazon Bedrock para os laboratórios (padrão: us-east-1)
REGION=us-east-1

# ID ou Inference Profile ARN do modelo fundacional (obrigatório para Shell)
# Exemplo Claude 3.5 Sonnet: us.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_ID=SEU_MODEL_ID

# ID da Knowledge Base criada no Amazon Bedrock (necessário para laboratórios 05-rag e 06-guardrails)
KB_ID=SEU_KNOWLEDGE_BASE_ID

# ID do Guardrail criado no Amazon Bedrock (necessário para v9-guardrail)
GUARDRAIL_ID=SEU_GUARDRAIL_ID

# Versão do Guardrail (padrão: DRAFT)
GUARDRAIL_VERSION=SUA_VERSAO

# Caminho ou nome opcional para prompt customizado (se não definido, usa shared/prompts/prompt-exemplo.txt)
# Precedência: 1. PROMPT_PATH | 2. PROMPT_FILE (em shared/prompts/) | 3. prompt-exemplo.txt
# PROMPT_PATH=/caminho/para/seu-prompt.txt
# PROMPT_FILE=prompt-exemplo.txt
