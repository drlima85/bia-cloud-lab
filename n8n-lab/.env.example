# ========================================================
# Desafio 5 - N8N na AWS: Template de Variáveis de Ambiente
# Copie este arquivo para .env no ambiente local:
#   cp .env.example .env && chmod 600 .env
# ========================================================

# Configurações AWS
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=<sua_conta_aws_12_digitos>
AWS_PROFILE=n8n-lab

# Amazon RDS PostgreSQL
N8N_DB_HOST=<endpoint_rds>.us-east-2.rds.amazonaws.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=<senha_postgres_ou_recuperada_ssm>

# AWS Systems Manager Parameter Store Paths
SSM_DB_PASSWORD_PATH=/n8n/db_password
SSM_ENCRYPTION_KEY_PATH=/n8n/encryption_key

# Domínio e Acesso
N8N_HOST=n8n.bia.d2ns.com.br
N8N_URL=https://n8n.bia.d2ns.com.br
