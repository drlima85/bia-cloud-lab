# ========================================================
# Desafio 6 - N8N Queue Mode: Template de Variáveis de Ambiente
# Copie este arquivo para .env no ambiente local:
#   cp .env.example .env && chmod 600 .env
# ========================================================

# Configurações AWS
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=<sua_conta_aws_12_digitos>
AWS_PROFILE=n8n-lab
VPC_ID=<vpc_id>
SUBNET_2A=<subnet_2a_id>
SUBNET_2B=<subnet_2b_id>

# Amazon RDS PostgreSQL
RDS_DB_NAME=n8n
RDS_ENDPOINT=<endpoint_rds>.us-east-2.rds.amazonaws.com
RDS_PORT=5432

# Amazon ElastiCache Valkey (Queue Mode)
VALKEY_REPLICATION_GROUP_ID=n8n-valkey
VALKEY_ENDPOINT=master.<replication_group>.<token>.use2.cache.amazonaws.com
VALKEY_PORT=6379
VALKEY_TLS_ENABLED=true

# AWS Systems Manager Parameter Store Paths (SecureString)
SSM_DB_PASSWORD_PATH=/n8n/db_password
SSM_ENCRYPTION_KEY_PATH=/n8n/encryption_key
SSM_VALKEY_TOKEN_PATH=/n8n/valkey_token

# Domínio e Acesso
ROUTE53_HOSTED_ZONE_ID=<hosted_zone_id>
ROUTE53_RECORD_NAME=n8n.bia.d2ns.com.br
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-2:<account>:certificate/<id>

# Balanceamento de Carga
ALB_ARN=arn:aws:elasticloadbalancing:us-east-2:<account>:loadbalancer/app/n8n-d2n-alb/<id>
ALB_DNS=n8n-d2n-alb-<id>.us-east-2.elb.amazonaws.com
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-2:<account>:targetgroup/tg-n8n-d2n/<id>

# Orquestração ECS
ECS_CLUSTER_NAME=cluster-n8n-d2n
CAPACITY_PROVIDER_NAME=cp-n8n-d2n
MAIN_SERVICE_NAME=svc-n8n-main
WORKER_SERVICE_NAME=svc-n8n-worker
CLOUDWATCH_LOG_GROUP=/ecs/n8n-ec2
