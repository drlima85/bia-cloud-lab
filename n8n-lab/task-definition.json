{
  "family": "task-def-n8n-d2n",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/n8n-task-execution-role",
  "containerDefinitions": [
    {
      "name": "n8n",
      "image": "n8nio/n8n:2.22.6",
      "memoryReservation": 650,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5678,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_TYPE", "value": "postgresdb" },
        { "name": "DB_POSTGRESDB_HOST", "value": "<RDS_ENDPOINT>.us-east-2.rds.amazonaws.com" },
        { "name": "DB_POSTGRESDB_PORT", "value": "5432" },
        { "name": "DB_POSTGRESDB_DATABASE", "value": "n8n" },
        { "name": "DB_POSTGRESDB_USER", "value": "postgres" },
        { "name": "DB_POSTGRESDB_SSL_ENABLED", "value": "true" },
        { "name": "DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED", "value": "false" },
        { "name": "N8N_HOST", "value": "n8n.<SEU_DOMINIO>" },
        { "name": "N8N_PORT", "value": "5678" },
        { "name": "N8N_PROTOCOL", "value": "https" },
        { "name": "N8N_EDITOR_BASE_URL", "value": "https://n8n.<SEU_DOMINIO>/" },
        { "name": "WEBHOOK_URL", "value": "https://n8n.<SEU_DOMINIO>/" },
        { "name": "N8N_PROXY_HOPS", "value": "1" },
        { "name": "N8N_SECURE_COOKIE", "value": "true" },
        { "name": "GENERIC_TIMEZONE", "value": "America/Sao_Paulo" }
      ],
      "secrets": [
        {
          "name": "DB_POSTGRESDB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-2:<AWS_ACCOUNT_ID>:parameter/n8n/db_password"
        },
        {
          "name": "N8N_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:<AWS_ACCOUNT_ID>:parameter/n8n/encryption_key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/n8n-ec2",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "n8n"
        }
      }
    }
  ]
}
